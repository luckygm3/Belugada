generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Papel {
  ADMIN
  EMPRESA
}

enum TipoTemplate {
  PADRAO
  PERSONALIZADO
}

enum StatusDocumentacao {
  PENDENTE
  EM_GERACAO
  COMPLETO
  EXPIRADO
}

enum StatusPagamento {
  ATIVO
  ATRASADO
  CANCELADO
}

enum TipoAtividade {
  CRIACAO
  EDICAO
  EXCLUSAO
  GERACAO_DOCUMENTO
  VENCIMENTO_PROXIMO
}

model Usuario {
  id           String   @id @default(cuid())
  emailOuLogin String   @unique
  senhaHash    String
  papel        Papel
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id])
  createdAt    DateTime @default(now())
  tokenReset       String?
  tokenResetExpira DateTime?

  // Configurações pessoais vinculadas à conta (tema, idioma, filtros salvos...).
  // JSON, não tabela separada: cresce por chave sem migration a cada preferência
  // nova, e ninguém precisa consultar isso além do próprio dono da conta —
  // ver src/lib/preferencias.ts pro shape validado em Zod.
  preferencias Json?

  notificacoes Notificacao[]
  consentimentosCookies ConsentimentoCookies[]
}

// Registro de auditoria do consentimento de cookies (LGPD) — um registro por
// escolha feita (aceitar/recusar/personalizar), não sobrescrito, pra
// preservar histórico. usuarioId fica null quase sempre (visitante anônimo
// da landing, que não tem conta) — só é preenchido no raro caso de alguém
// já logado revisitar a landing e mexer nas preferências de cookies.
model ConsentimentoCookies {
  id           String   @id @default(cuid())
  essenciais   Boolean  @default(true)
  preferencias Boolean
  analytics    Boolean
  usuarioId    String?
  usuario      Usuario? @relation(fields: [usuarioId], references: [id])
  criadoEm     DateTime @default(now())

  @@index([criadoEm])
}

model Empresa {
  id                  String   @id @default(cuid())
  cnpj                String   @unique
  razaoSocial         String
  nomeFantasia        String?
  dataAbertura        DateTime?
  situacaoCadastral   String?
  naturezaJuridica    String?
  capitalSocial       Float?
  porteEmpresa        String?
  cnaePrincipal       String?
  cnaesSecundarios    String[]
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  uf                  String?
  cep                 String?
  telefone            String?
  emailCorporativo    String?
  quadroSocietario    Json?
  planoContratado     String?
  dataInicioContrato  DateTime?
  dataRenovacao       DateTime?
  statusPagamento     StatusPagamento @default(ATIVO)
  responsavelNome     String?
  responsavelCargo    String?
  responsavelTelefone String?
  responsavelEmail    String?
  templatesPadraoSelecionados EmpresaTemplatePadrao[]
  templatesPersonalizadosSelecionados EmpresaTemplatePersonalizado[]

  usuarios     Usuario[]
  funcionarios Funcionario[]
  templates    TemplateDocumento[]
  notificacoes Notificacao[]
  createdAt    DateTime @default(now())
}

model Funcionario {
  id                  String   @id @default(cuid())
  empresaId           String
  empresa             Empresa  @relation(fields: [empresaId], references: [id])

  nomeCompleto        String
  cpf                 String   @unique
  rg                  String?
  orgaoEmissor        String?
  ufEmissao           String?
  dataNascimento      DateTime?
  estadoCivil         String?
  nacionalidade       String?

  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  uf                  String?
  cep                 String?
  telefone            String?
  email               String?

  matriculaInterna    String?
  cargo               String?
  cbo                 String?
  departamento        String?
  dataAdmissao        DateTime?
  tipoContrato        String?
  jornadaTrabalho     String?
  salarioBase         Float?
  ctpsNumero          String?
  ctpsSerie           String?
  pisNis              String?

  dependentes         Json?
  statusDocumentacao  StatusDocumentacao @default(PENDENTE)
  dataUltimaGeracao   DateTime?
  dataTerminoContrato DateTime?

  documentosGerados   DocumentoGerado[]
  createdAt           DateTime @default(now())
}

model EmpresaTemplatePersonalizado {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  templateId String
  template   TemplateDocumento @relation(fields: [templateId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([empresaId, templateId])
}

enum OrigemTemplate {
  UPLOAD
  EDITOR
}
model TemplateDocumento {
  id                  String       @id @default(cuid())
  nome                String
  tipo                TipoTemplate
  origem              OrigemTemplate  @default(UPLOAD)
  arquivoUrl          String?         // usado quando origem = UPLOAD
  conteudo            Json?           // usado quando origem = EDITOR (JSON do TipTap)
  empresaId           String?
  empresa             Empresa?     @relation(fields: [empresaId], references: [id])
  arquivoOriginalUrl  String?
  variaveisDetectadas String[]
  ativo               Boolean      @default(true)

  // Vencimento: qual variável [[chave]] representa a data-limite deste tipo de
  // documento (ex: "data_termino_contrato"). Null = documento sem vencimento.
  variavelVencimento    String?
  diasAlertaVencimento  Int[]      @default([])

  empresasQueUsam EmpresaTemplatePadrao[]
  empresasQueUsamPersonalizado EmpresaTemplatePersonalizado[]
  documentosGerados   DocumentoGerado[]
  createdAt           DateTime @default(now())
}

model DocumentoGerado {
  id                  String   @id @default(cuid())
  funcionarioId       String
  funcionario         Funcionario @relation(fields: [funcionarioId], references: [id])
  templateId          String
  template            TemplateDocumento @relation(fields: [templateId], references: [id])
  urlPdf              String?
  statusAssinatura    String?
  dataGeracao         DateTime @default(now())

  // Resolvida a partir de template.variavelVencimento no momento da geração —
  // é um snapshot, não recalculada depois (o documento já foi emitido com essa data).
  dataVencimento      DateTime?
  alertasEnviados     AlertaVencimentoEnviado[]

  @@index([dataVencimento])
}

model EmpresaTemplatePadrao {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  templateId String
  template   TemplateDocumento @relation(fields: [templateId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([empresaId, templateId])
}

// Log de atividades da empresa-cliente + central de notificações compartilhada
// entre todos os admins (leitura não é por usuário — é uma única lista central).
model Notificacao {
  id          String        @id @default(cuid())
  tipo        TipoAtividade
  descricao   String
  // entidade/entidadeId são só informativos (sem FK): a ação pode se referir a um
  // registro já excluído (ex: notificação de exclusão de funcionário), então uma
  // FK real quebraria ou exigiria cascade que apagaria o próprio histórico.
  entidade    String
  entidadeId  String?
  empresaId   String
  empresa     Empresa       @relation(fields: [empresaId], references: [id])
  usuarioId   String?
  usuario     Usuario?      @relation(fields: [usuarioId], references: [id])
  lida        Boolean       @default(false)
  createdAt   DateTime      @default(now())

  // Só preenchido em tipo = VENCIMENTO_PROXIMO: o marco (30/15/7...) que disparou
  // este alerta, usado pra estilizar urgência na UI sem precisar reprocessar texto.
  diasAntecedencia Int?

  @@index([empresaId])
  @@index([lida])
  @@index([createdAt])
}

// Idempotência dos alertas de vencimento: um registro por (documento, marco) já
// notificado. A unique constraint garante, no banco, que o cron nunca duplica um
// alerta mesmo rodando mais de uma vez — ao contrário de um array na aplicação.
model AlertaVencimentoEnviado {
  id                String          @id @default(cuid())
  documentoGeradoId String
  documentoGerado   DocumentoGerado @relation(fields: [documentoGeradoId], references: [id], onDelete: Cascade)
  diasAntecedencia  Int
  enviadoEm         DateTime        @default(now())

  @@unique([documentoGeradoId, diasAntecedencia])
}