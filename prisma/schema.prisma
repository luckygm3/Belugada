generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Papel {
  ADMIN
  EMPRESA
}

enum TipoTemplate {
  PADRAO
  PERSONALIZADO
}

enum StatusDocumentacao {
  PENDENTE
  EM_GERACAO
  COMPLETO
  EXPIRADO
}

enum StatusPagamento {
  ATIVO
  ATRASADO
  CANCELADO
}

enum TipoAtividade {
  CRIACAO
  EDICAO
  EXCLUSAO
  GERACAO_DOCUMENTO
  VENCIMENTO_PROXIMO
}

model Usuario {
  id           String   @id @default(cuid())
  emailOuLogin String   @unique
  senhaHash    String
  papel        Papel
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id])
  createdAt    DateTime @default(now())
  tokenReset       String?
  tokenResetExpira DateTime?

  // Identidade exibível — coluna própria (não Json) porque é dado estrutural,
  // não preferência. avatarUrl guarda a URL pública completa do bucket
  // "avatares" (Storage público), não um caminho relativo como em templates.
  nome      String?
  avatarUrl String?

  // false = acesso revogado (checado em authorize(), bloqueia login). Hoje só
  // a UI de Administração Geral mexe nisso, e só pra papel ADMIN, mas o campo
  // é genérico — vale pra qualquer papel.
  ativo Boolean @default(true)

  // 2FA (TOTP) — ver src/lib/doisFatores.ts e src/lib/criptografia.ts.
  // Segredo criptografado (AES-256-GCM, "iv:tag:ciphertext" em hex), nunca em
  // texto puro no banco. null = 2FA nunca configurado.
  totpSecretCriptografado String?
  totpAtivado             Boolean  @default(false)
  // Hashes bcrypt dos códigos de backup restantes — mesmo tratamento de
  // segredo que a senha. Consumidos (removidos do array) no uso.
  totpCodigosBackup       String[] @default([])

  logsAcesso LogAcesso[]

  // Configurações pessoais vinculadas à conta (tema, idioma, filtros salvos...).
  // JSON, não tabela separada: cresce por chave sem migration a cada preferência
  // nova, e ninguém precisa consultar isso além do próprio dono da conta —
  // ver src/lib/preferencias.ts pro shape validado em Zod.
  preferencias Json?

  notificacoes Notificacao[]
  consentimentosCookies ConsentimentoCookies[]
  sessoesAtivas SessaoAtiva[]
  notasFeedback NotaFeedback[]
}

// Sessões ativas por usuário (login JWT sem adapter de banco). Cada login cria
// um registro; o id deste registro vira o sessionId embutido no JWT e é
// revalidado (com throttle) no callback jwt do Auth.js — ver src/auth.ts.
// revogadaEm nulo = sessão válida; preenchido = sessão encerrada remotamente,
// mantendo histórico em vez de apagar a linha.
model SessaoAtiva {
  id         String    @id @default(cuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  criadoEm   DateTime  @default(now())
  ultimoUso  DateTime  @default(now())
  revogadaEm DateTime?

  @@index([usuarioId])
}

// Registro de auditoria do consentimento de cookies (LGPD) — um registro por
// escolha feita (aceitar/recusar/personalizar), não sobrescrito, pra
// preservar histórico. usuarioId fica null quase sempre (visitante anônimo
// da landing, que não tem conta) — só é preenchido no raro caso de alguém
// já logado revisitar a landing e mexer nas preferências de cookies.
model ConsentimentoCookies {
  id           String   @id @default(cuid())
  essenciais   Boolean  @default(true)
  preferencias Boolean
  analytics    Boolean
  usuarioId    String?
  usuario      Usuario? @relation(fields: [usuarioId], references: [id])
  criadoEm     DateTime @default(now())

  @@index([criadoEm])
}

model Empresa {
  id                  String   @id @default(cuid())
  cnpj                String   @unique
  razaoSocial         String
  nomeFantasia        String?
  dataAbertura        DateTime?
  situacaoCadastral   String?
  naturezaJuridica    String?
  capitalSocial       Float?
  porteEmpresa        String?
  cnaePrincipal       String?
  cnaesSecundarios    String[]
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  uf                  String?
  cep                 String?
  telefone            String?
  emailCorporativo    String?
  quadroSocietario    Json?
  planoContratado     String?
  dataInicioContrato  DateTime?
  dataRenovacao       DateTime?
  statusPagamento     StatusPagamento @default(ATIVO)
  responsavelNome     String?
  responsavelCargo    String?
  responsavelTelefone String?
  responsavelEmail    String?

  // Representante legal p/ qualificação em documentos (ex: D20) — distinto do
  // responsavel* acima, que é o contato comercial da empresa-cliente.
  representanteLegalNome  String?
  representanteLegalCargo String?
  representanteLegalCpf   String?

  templatesPadraoSelecionados EmpresaTemplatePadrao[]
  templatesPersonalizadosSelecionados EmpresaTemplatePersonalizado[]

  usuarios     Usuario[]
  funcionarios Funcionario[]
  templates    TemplateDocumento[]
  notificacoes Notificacao[]
  createdAt    DateTime @default(now())
}

model Funcionario {
  id                  String   @id @default(cuid())
  empresaId           String
  empresa             Empresa  @relation(fields: [empresaId], references: [id])

  nomeCompleto        String
  cpf                 String   @unique
  rg                  String?
  orgaoEmissor        String?
  ufEmissao           String?
  dataNascimento      DateTime?
  estadoCivil         String?
  nacionalidade       String?

  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  uf                  String?
  cep                 String?
  telefone            String?
  email               String?

  matriculaInterna    String?
  cargo               String?
  cbo                 String?
  departamento        String?
  dataAdmissao        DateTime?
  tipoContrato        String?
  jornadaTrabalho     String?
  salarioBase         Float?
  ctpsNumero          String?
  ctpsSerie           String?
  pisNis              String?

  dependentes         Json?
  statusDocumentacao  StatusDocumentacao @default(PENDENTE)
  dataUltimaGeracao   DateTime?
  dataTerminoContrato DateTime?

  documentosGerados   DocumentoGerado[]
  createdAt           DateTime @default(now())
}

model EmpresaTemplatePersonalizado {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  templateId String
  template   TemplateDocumento @relation(fields: [templateId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([empresaId, templateId])
}

enum OrigemTemplate {
  UPLOAD
  EDITOR
}
model TemplateDocumento {
  id                  String       @id @default(cuid())
  nome                String
  tipo                TipoTemplate
  origem              OrigemTemplate  @default(UPLOAD)
  arquivoUrl          String?         // usado quando origem = UPLOAD
  conteudo            Json?           // usado quando origem = EDITOR (JSON do TipTap)
  empresaId           String?
  empresa             Empresa?     @relation(fields: [empresaId], references: [id])
  arquivoOriginalUrl  String?
  variaveisDetectadas String[]
  ativo               Boolean      @default(true)

  // Vencimento: qual variável [[chave]] representa a data-limite deste tipo de
  // documento (ex: "data_termino_contrato"). Null = documento sem vencimento.
  variavelVencimento    String?
  diasAlertaVencimento  Int[]      @default([])

  // Vencimento individual, definido no upload — mutuamente exclusivo entre si e
  // com prioridade sobre variavelVencimento na hora de gerar o documento (ver
  // resolverDataVencimento em src/lib/obterDataVencimento.ts).
  vencimentoIndividualData  DateTime?
  vencimentoIndividualDias  Int?

  empresasQueUsam EmpresaTemplatePadrao[]
  empresasQueUsamPersonalizado EmpresaTemplatePersonalizado[]
  documentosGerados   DocumentoGerado[]
  createdAt           DateTime @default(now())
}

model DocumentoGerado {
  id                  String   @id @default(cuid())
  funcionarioId       String
  funcionario         Funcionario @relation(fields: [funcionarioId], references: [id])
  templateId          String
  template            TemplateDocumento @relation(fields: [templateId], references: [id])
  urlPdf              String?
  statusAssinatura    String?
  dataGeracao         DateTime @default(now())

  // Resolvida a partir de template.variavelVencimento no momento da geração —
  // é um snapshot, não recalculada depois (o documento já foi emitido com essa data).
  dataVencimento      DateTime?
  alertasEnviados     AlertaVencimentoEnviado[]

  // Valores de escopo "documento" (sem origem no Prisma) informados no
  // formulário de emissão — testemunhas, valores de multa, itens de trajeto
  // etc. Snapshot: preserva o que foi digitado mesmo se o catálogo mudar depois.
  dadosEntrada        Json?

  @@index([dataVencimento])
}

model EmpresaTemplatePadrao {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  templateId String
  template   TemplateDocumento @relation(fields: [templateId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([empresaId, templateId])
}

// Log de atividades da empresa-cliente + central de notificações compartilhada
// entre todos os admins (leitura não é por usuário — é uma única lista central).
model Notificacao {
  id          String        @id @default(cuid())
  tipo        TipoAtividade
  descricao   String
  // entidade/entidadeId são só informativos (sem FK): a ação pode se referir a um
  // registro já excluído (ex: notificação de exclusão de funcionário), então uma
  // FK real quebraria ou exigiria cascade que apagaria o próprio histórico.
  entidade    String
  entidadeId  String?
  empresaId   String
  empresa     Empresa       @relation(fields: [empresaId], references: [id])
  usuarioId   String?
  usuario     Usuario?      @relation(fields: [usuarioId], references: [id])
  lida        Boolean       @default(false)
  createdAt   DateTime      @default(now())

  // Só preenchido em tipo = VENCIMENTO_PROXIMO: o marco (30/15/7...) que disparou
  // este alerta, usado pra estilizar urgência na UI sem precisar reprocessar texto.
  diasAntecedencia Int?

  @@index([empresaId])
  @@index([lida])
  @@index([createdAt])
}

// Idempotência dos alertas de vencimento: um registro por (documento, marco) já
// notificado. A unique constraint garante, no banco, que o cron nunca duplica um
// alerta mesmo rodando mais de uma vez — ao contrário de um array na aplicação.
model AlertaVencimentoEnviado {
  id                String          @id @default(cuid())
  documentoGeradoId String
  documentoGerado   DocumentoGerado @relation(fields: [documentoGeradoId], references: [id], onDelete: Cascade)
  diasAntecedencia  Int
  enviadoEm         DateTime        @default(now())

  @@unique([documentoGeradoId, diasAntecedencia])
}

// Notas rápidas de feedback ("Notei falta de algo") — captura livre, sem
// fluxo de resposta nessa fase. `visto` é só pro admin sinalizar o que já foi
// tratado, sem afetar mais nada no sistema (não é status de workflow).
model NotaFeedback {
  id           String   @id @default(cuid())
  texto        String
  paginaOrigem String
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  visto        Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Configurações globais do sistema — singleton (sempre um único registro, id
// fixo "global"). Json, não colunas dedicadas: mesmo padrão já usado em
// Usuario.preferencias — hoje só guarda os prazos de alerta de vencimento,
// mas Administração Geral é pensada pra crescer com mais ajustes globais sem
// migration nova — ver src/lib/configuracaoGlobal.ts pro shape validado em Zod.
model ConfiguracaoGlobal {
  id        String   @id @default("global")
  valores   Json?
  updatedAt DateTime @updatedAt
}

// Log de login — diferente de Notificacao (atividade de negócio). Guarda só o
// essencial pra o próprio usuário reconhecer "fui eu que entrei ali": sem
// geolocalização, sem nada além de IP/user-agent brutos. Não é criado quando
// o e-mail nem existe no banco (evita ruído de bots e sinal de enumeração).
model LogAcesso {
  id          String   @id @default(cuid())
  usuarioId   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sucesso     Boolean
  // "senha_incorreta" | "conta_revogada" | "2fa_invalido" | null quando sucesso
  motivoFalha String?
  userAgent   String?
  ip          String?
  criadoEm    DateTime @default(now())

  @@index([usuarioId])
  @@index([criadoEm])
}

enum TipoEventoAuditoria {
  GERACAO
  DOWNLOAD
  SUBSTITUIDO
}

// Trilha de auditoria por documento gerado — append-only por design: sem
// endpoint de update/delete em nenhum lugar da aplicação (documentos podem
// virar prova em relação de trabalho). documentoGeradoId e usuarioId são
// referências informativas (sem @relation), mesmo padrão de
// Notificacao.entidade/entidadeId — a trilha precisa sobreviver mesmo se o
// documento ou o usuário forem removidos depois (uma FK real com cascade
// apagaria a prova junto; sem cascade, bloquearia pra sempre a exclusão de
// um funcionário que já gerou qualquer documento).
model AuditoriaDocumento {
  id                String              @id @default(cuid())
  documentoGeradoId String
  tipo              TipoEventoAuditoria
  usuarioId         String?
  usuarioNome       String?
  criadoEm          DateTime            @default(now())

  // Só em tipo = GERACAO — snapshot completo pra reconstituir o contexto da
  // geração mesmo que os dados do funcionário ou o template mudem depois.
  templateId      String?
  templateNome    String?
  templateHash    String? // sha256 do conteúdo do template usado nessa geração
  variaveisUsadas Json?   // saída de mapearVariaveis() naquele momento

  // Só em tipo = SUBSTITUIDO — aponta pro documento novo que passou a valer.
  documentoSubstitutoId String?

  @@index([documentoGeradoId])
  @@index([criadoEm])
}